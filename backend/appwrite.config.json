        {
            "$id": "bt_stats",
            "$permissions": [
                "read(\"users\")"
            ],
            "databaseId": "hawkbee",
            "name": "BT Stats",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "scope",
                    "type": "varchar",
                    "required": true,
                    "size": 8
                },
                {
                    "key": "scope_id",
                    "type": "varchar",
                    "required": true,
                    "size": 64
                },
                {
                    "key": "war_id",
                    "type": "varchar",
                    "required": false,
                    "size": 64
                },
                {
                    "key": "subject",
                    "type": "varchar",
                    "required": true,
                    "size": 8
                },
                {
                    "key": "subject_id",
                    "type": "varchar",
                    "required": true,
                    "size": 64
                },
                {
                    "key": "stats",
                    "type": "text",
                    "required": true
                }
            ],
            "indexes": [
                {
                    "key": "by_war",
                    "type": "key",
                    "columns": [
                        "scope",
                        "war_id"
                    ],
                    "orders": [
                        "ASC",
                        "ASC"
                    ]
                },
                {
                    "key": "by_subject",
                    "type": "key",
                    "columns": [
                        "scope",
                        "subject",
                        "subject_id"
                    ],
                    "orders": [
                        "ASC",
                        "ASC",
                        "ASC"
                    ]
                }
            ]
